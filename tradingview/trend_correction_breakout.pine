//@version=5
// Trend + Correction Detector
// 1) TREND UTAMA  : struktur pivot besar (BOS) dan/atau EMA.
// 2) TREND KOREKSI: garis berlawanan arah trend utama dari pivot kecil.
//      Trend naik  -> koreksi turun -> garis dari swing high ke lower high.
//      Trend turun -> koreksi naik  -> garis dari swing low ke higher low.
// Tidak ada sinyal entry: keputusan buy/sell ditentukan sendiri oleh trader.
indicator("Trend + Correction Detector", "TCD", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 1000)

// ───────── Input ─────────
grpT = "1. Trend Utama"
trendMode  = input.string("Struktur + EMA", "Penentu trend utama", options = ["Struktur", "EMA", "Struktur + EMA"], group = grpT)
majorLen   = input.int(20, "Pivot trend utama (kiri/kanan)", minval = 5, group = grpT)
emaLen     = input.int(200, "Panjang EMA", minval = 1, group = grpT)
showEma    = input.bool(true, "Tampilkan EMA", group = grpT)
showStruct = input.bool(true, "Label HH / HL / LH / LL", group = grpT)
showBg     = input.bool(true, "Warna background sesuai trend", group = grpT)

grpC = "2. Trend Koreksi"
minorLen   = input.int(4, "Pivot koreksi (kiri/kanan)", minval = 2, group = grpC)
useWick    = input.bool(false, "Validasi garis pakai wick", group = grpC)
tolAtr     = input.float(0.05, "Toleransi tembus (x ATR)", minval = 0, step = 0.05, group = grpC)
minBars    = input.int(5, "Minimal panjang koreksi (bar)", minval = 1, group = grpC)
maxAge     = input.int(300, "Umur maksimum garis (bar)", minval = 20, maxval = 990, group = grpC)
keepBroken = input.bool(true, "Simpan garis koreksi yang sudah ditembus", group = grpC)
showBreak  = input.bool(false, "Tandai titik tembus garis koreksi", group = grpC)
corrCol    = input.color(color.new(color.orange, 0), "Warna garis koreksi", group = grpC)
lineW      = input.int(2, "Tebal garis", minval = 1, maxval = 5, group = grpC)

// ───────── Trend utama ─────────
atr = ta.atr(14)
tol = nz(atr) * tolAtr
ema = ta.ema(close, emaLen)

mph = ta.pivothigh(high, majorLen, majorLen)
mpl = ta.pivotlow(low, majorLen, majorLen)

var float majH     = na
var float majL     = na
var int   structTr = 0

if not na(mph)
    if showStruct
        string txt = na(majH) ? "H" : mph > majH ? "HH" : "LH"
        label.new(bar_index - majorLen, mph, txt, style = label.style_label_down, color = color.new(color.gray, 100), textcolor = color.gray, size = size.small)
    majH := mph
if not na(mpl)
    if showStruct
        string txt = na(majL) ? "L" : mpl > majL ? "HL" : "LL"
        label.new(bar_index - majorLen, mpl, txt, style = label.style_label_up, color = color.new(color.gray, 100), textcolor = color.gray, size = size.small)
    majL := mpl

if not na(majH) and close > majH and structTr != 1
    structTr := 1
if not na(majL) and close < majL and structTr != -1
    structTr := -1

int emaTr = close > ema ? 1 : close < ema ? -1 : 0
int trend = trendMode == "Struktur" ? structTr : trendMode == "EMA" ? emaTr : structTr == emaTr ? structTr : 0

// ───────── Trend koreksi ─────────
pph = ta.pivothigh(high, minorLen, minorLen)
ppl = ta.pivotlow(low, minorLen, minorLen)

var int   aX      = na
var float aY      = na
var int   pX      = na
var float pY      = na
var line  cLine   = na
var int   lX      = na
var float lY      = na
var float cSlope  = na
var bool  cActive = false

validLine(int x1, float y1, float slope, int d) =>
    bool ok = true
    for i = 0 to bar_index - x1
        float lp  = y1 + slope * (bar_index - i - x1)
        float src = useWick ? (d == 1 ? high[i] : low[i]) : close[i]
        if d * (src - lp) > tol
            ok := false
            break
    ok

if trend != nz(trend[1])
    if cActive
        line.delete(cLine)
    cActive := false
    aX := na
    aY := na
    pX := na
    pY := na

int d = trend
bool corrBreakUp = false
bool corrBreakDn = false

if cActive and d != 0
    float y = lY + cSlope * (bar_index - lX)
    line.set_xy2(cLine, bar_index, y)
    if d * (close - y) > tol
        bool longEnough = bar_index - aX >= minBars
        if longEnough
            corrBreakUp := d == 1
            corrBreakDn := d == -1
            if showBreak
                label.new(bar_index, d == 1 ? low : high, "x", style = d == 1 ? label.style_label_up : label.style_label_down, color = color.new(corrCol, 20), textcolor = color.white, size = size.tiny, yloc = d == 1 ? yloc.belowbar : yloc.abovebar)
        if not longEnough or not keepBroken
            line.delete(cLine)
        cActive := false
        aX := na
        aY := na
    else if bar_index - lX > maxAge
        line.delete(cLine)
        cActive := false

float piv = d == 1 ? pph : d == -1 ? ppl : na
if not na(piv)
    int   x2 = bar_index - minorLen
    float y2 = piv
    if not na(aX) and bar_index - aX > maxAge
        aY := na
    if na(aY) or d * (y2 - aY) >= 0
        if cActive
            line.delete(cLine)
            cActive := false
        aX := x2
        aY := y2
    else
        int   ax = na
        float ay = na
        float sl = na
        float s1 = (y2 - aY) / (x2 - aX)
        if validLine(aX, aY, s1, d)
            ax := aX
            ay := aY
            sl := s1
        else if not na(pY) and pX > aX and d * (pY - y2) > 0
            float s2 = (y2 - pY) / (x2 - pX)
            if validLine(pX, pY, s2, d)
                ax := pX
                ay := pY
                sl := s2
        if not na(sl)
            if cActive
                line.delete(cLine)
            cLine   := line.new(ax, ay, bar_index, ay + sl * (bar_index - ax), color = corrCol, width = lineW)
            lX      := ax
            lY      := ay
            cSlope  := sl
            cActive := true
    pX := x2
    pY := y2

plot(showEma ? ema : na, "EMA", color = color.new(color.purple, 0))
bgcolor(showBg ? (trend == 1 ? color.new(color.teal, 92) : trend == -1 ? color.new(color.red, 92) : na) : na)

// ───────── Panel info ─────────
var table tb = table.new(position.top_right, 2, 2, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    table.cell(tb, 0, 0, "Trend utama", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, trend == 1 ? "NAIK" : trend == -1 ? "TURUN" : "NETRAL", text_color = trend == 1 ? color.lime : trend == -1 ? color.red : color.gray, text_size = size.small)
    table.cell(tb, 0, 1, "Koreksi", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, cActive ? (trend == 1 ? "Koreksi turun - garis aktif" : "Koreksi naik - garis aktif") : na(aY) ? "Menunggu swing" : "Menunggu pivot koreksi", text_color = color.orange, text_size = size.small)

alertcondition(corrBreakUp, "Garis koreksi ditembus (trend naik)", "Trend naik: garis koreksi turun ditembus ke atas")
alertcondition(corrBreakDn, "Garis koreksi ditembus (trend turun)", "Trend turun: garis koreksi naik ditembus ke bawah")
